# Copy to .env.local and fill in. Every value here is server-only —
# never expose one of these as NEXT_PUBLIC_*.

# Postgres. Matches the docker-compose.yml service for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/image_gallery

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Object storage. These defaults point at the MinIO service in
# docker-compose.yml, so a fresh clone works with no Cloudflare account:
#   docker compose up -d && pnpm ensure-bucket
#
# For production, delete R2_ENDPOINT and fill in the real Cloudflare R2 values.
# R2_ACCOUNT_ID is only used to build R2's endpoint, so it is not needed while
# R2_ENDPOINT is set. R2_PUBLIC_URL must be publicly readable — the bucket's
# r2.dev subdomain (enable "Public Development URL") or a custom domain. Its
# hostname is added to next.config.ts images.remotePatterns automatically.
R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=image-gallery
R2_PUBLIC_URL=http://localhost:9000/image-gallery

# Anthropic vision model for alt text and tags. One call per upload, on the
# 400px thumbnail — Haiku is plenty for that and keeps the demo's credit spend
# down (SPEC §7). Override per environment if you want richer alt text.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# true on the public demo: disables registration so visitors use the seeded account
DEMO_MODE=false
